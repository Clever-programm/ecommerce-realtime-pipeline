# ─────────────────────────────────────────────────────────────
# Переменные окружения конвейера данных АС «RTP»
# Скопировать в .env перед запуском: cp .env.example .env
# ─────────────────────────────────────────────────────────────

# Брокер сообщений
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_EXTERNAL_PORT=9094
KAFKA_TOPIC_EVENTS=events-raw
KAFKA_TOPIC_LOGS=logs-raw
KAFKA_RETENTION_DAYS=7

# Хранилище витрин (локальная реляционная СУБД)
POSTGRES_DWH_HOST=postgres-dwh
POSTGRES_DWH_PORT=5432
POSTGRES_DWH_DB=marts
POSTGRES_DWH_USER=analytics
POSTGRES_DWH_PASSWORD=analytics_secret
POSTGRES_DWH_EXTERNAL_PORT=5433

# Внешний источник (база данных с подготовленными событиями)
POSTGRES_EXT_DB=shop_source
POSTGRES_EXT_USER=source_ro
POSTGRES_EXT_PASSWORD=source_secret
POSTGRES_EXT_EXTERNAL_PORT=5434
EXTERNAL_API_URL=http://external-api:8000
EXTERNAL_API_KEY=dev-api-key-change-me

# Аналитическая СУБД (потоковые витрины)
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=analyst
CLICKHOUSE_PASSWORD=analyst_secret
CLICKHOUSE_EXTERNAL_PORT=8123

# Озеро данных
MINIO_ENDPOINT=minio:9000
MINIO_EXTERNAL_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secret_key
MINIO_BUCKET_RAW=raw
MINIO_BUCKET_STAGING=staging

# Оркестратор
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_secret
AIRFLOW_EXTERNAL_PORT=8080

# Мониторинг
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=grafana_secret
GRAFANA_EXTERNAL_PORT=3000
PROMETHEUS_EXTERNAL_PORT=9090

# Генератор событий (эмуляция фронтенда и веб-сервера)
GENERATOR_RATE_PER_SEC=20
